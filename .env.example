# ==============================================================
# HireStack Environment Configuration Example
# ==============================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/hirestack_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Spring Security & JWT Token Generation
# 256-bit base64-encoded secret key
JWT_SECRET=replace_with_your_own_secret_key
JWT_EXPIRATION_MS=86400000

# File Storage Configuration (local, s3, cloudinary)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads

# Cloudinary (Optional - if STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (Optional - if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=hirestack-resumes

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

